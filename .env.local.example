# Copy these *names* into .env.local and supply your own credentials.
PGHOST=localhost
PGUSER=postgres
PGDATABASE=top_users
PGPASSWORD=replace_with_your_own_password
PGPORT=5432

# Generate a random 32-byte secret (64 hex digits) with:
# node -e "console.log(require('node:crypto').randoBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_64_character_hex_string

# Keep NODE_ENV unset locally so the cookie works over HTTP.
# NODE_ENV=production
